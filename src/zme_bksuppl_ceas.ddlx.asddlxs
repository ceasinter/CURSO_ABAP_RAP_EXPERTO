@Metadata.layer: #CORE

@UI.headerInfo.typeName: 'Booking Supplement'
@UI.headerInfo.typeNamePlural: 'Booking Supplements'
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'BookingSupplementID'
@UI.headerInfo.title.label: 'Booking Supplement'


annotate entity zc_bksuppl_ceas with
{

  @UI.facet: [

  //PESTAÑA DE BOOKING SUPPLEMENT
  {
  id: 'BookingSupplement',
  purpose: #STANDARD,
  type: #IDENTIFICATION_REFERENCE,
  label: 'Booking Supplement',
  position: 10
  }]

  @UI.hidden: true
  BooksupplUUID;

  @UI.hidden: true
  TravelUUID;

  @UI.hidden: true
  BookingUUID;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  BookingSupplementID;

  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.identification: [{ position: 20 }]
  SupplementID;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.identification: [{ position: 30 }]
  @UI.textArrangement: #TEXT_ONLY
  SupplementDescription;

  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  @UI.identification: [{ position: 40 }]
  Price;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ position: 50 }]
  CurrencyCode;

  @UI.hidden: true
  LocalLastChangedAt;

}