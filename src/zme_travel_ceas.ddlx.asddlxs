//METADATA EXTENSION: ES DONDE SE DEFINEN LAS ESTRUCTURAS DE LA INTERFAZ DE USUARIO FIORI ELEMENT,
//ES EL DESARROLLO FRONTEND A TRAVÉS DEL MODELO ABAP RAP.

@Metadata.layer: #CORE


// CABECERA DE LA INTERFAZ DE USUARIO

@UI: {
    headerInfo:
    {
        typeName: 'Travel',
        typeNamePlural: 'Travels',
        title:
        {
            type: #STANDARD,
            value: 'TravelID'
        },

        description:
        {
            type: #STANDARD
        }
     },

     presentationVariant:
     [{
            sortOrder:
            [{ by: 'TravelID',
               direction: #DESC
             }],
             visualizations:
             [{
                    type: #AS_LINEITEM
             }]
     }]
}

annotate entity zc_travel_ceas with
{

  //CREACIÓN DE PESTAÑAS PARA LA PANTALLA DE DETALLE
  @UI.facet: [{
      id: 'Travel',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Travel',
      position: 10 },
      {
      id: 'Booking',
       purpose: #STANDARD,
       type: #LINEITEM_REFERENCE,
       label: 'Booking',
       position: 20,
       targetElement: '_Booking'
      }]

   //COLUMNAS QUE SE MOSTRARAN EN LA GRILLA O ALV DE LA INTERFAZ FIORI ELEMENT
  @UI.hidden: true
  TravelUUID;

  @UI:
  {
    lineItem: [{
        position: 10,
        importance: #HIGH
     },

  //     AGREGAR BOTONES
     { type:#FOR_ACTION,

  //     ESTA ACCIÓN dataAction: 'acceptTravel' VA ASOCIADA AL BEHAVIOR DEFINITION EN LA PARTE DE ACTIONS
     dataAction: 'acceptTravel',
        label: 'Accept',
        position: 10
      },

      { type:#FOR_ACTION,
     dataAction: 'rejectTravel',
        label: 'Reject',
        position: 20
      },
      { type:#FOR_ACTION,

  //      ESTA ACCIÓN SERÍA ASOCIADA EN EL BEHAVIOR DEFINITION COMO UNA ACCIÓN CON PARÁMETRO
  //      QUE SERÁ DESIGNADO DE LA ENTIDAD ABSTRACTA ( ZABST_DISCCOUNT_CEAS )
     dataAction: 'deductDiscount',
        label: 'Discount',
        position: 30,
        invocationGrouping: #CHANGE_SET
      }],

     //    CAMPO DE SELECCIÓN DE FILTROS QUE SE MOSTRARAN EN LA CABECERA DE PANTALLA
     selectionField: [{  position: 10}],

  //     MUESTRA EL CAMPO EL LA PANTALLA DE DETALLE
     identification: [{ position: 10 },
     { type:#FOR_ACTION,
     dataAction: 'acceptTravel',
        label: 'Accept'
      },
      { type:#FOR_ACTION,
     dataAction: 'rejectTravel',
        label: 'Reject',
        position: 20
      },
      { type:#FOR_ACTION,
     dataAction: 'deductDiscount',
        label: 'Discount',
        position: 30,
        invocationGrouping: #CHANGE_SET
      }]
  }
  TravelID;

  @UI.lineItem: [{
    position: 20,
    importance: #HIGH
   }]

  //     MUESTRA EL CAMPO EL LA PANTALLA DE DETALLE
  @UI.identification: [{ position: 20 }]

  //    CAMPO DE SELECCIÓN DE FILTROS QUE SE MOSTRARAN EN LA CABECERA DE PANTALLA
  @UI.selectionField: [{ position: 20 }]
  AgencyID;

  @UI.lineItem: [{
      position: 30,
      importance: #HIGH
   }]
  //    CAMPO DE SELECCIÓN DE FILTROS QUE SE MOSTRARAN EN LA CABECERA DE PANTALLA
  @UI.selectionField: [{ position: 30 }]

  //     MUESTRA EL CAMPO EL LA PANTALLA DE DETALLE
  @UI.identification: [{ position: 30 }]
  CustomerID;

  @UI.lineItem: [{
      position: 40,
      importance: #MEDIUM
   }]
  @UI.identification: [{ position: 40 }]
  BeginDate;

  @UI.lineItem: [{
  position: 50,
  importance: #MEDIUM
  }]
  @UI.identification: [{ position: 50 }]
  EndDate;

  @UI.lineItem: [{
      position: 60,
      importance: #HIGH
  }]
  @UI.identification: [{ position: 60 }]
  BookingFee;

  @UI.lineItem: [{
  position: 70,
  importance: #HIGH
  }]

  //  MUESTRA EL CAMPO EN LA PANTALLA DETALLE
  @UI.identification: [{ position: 70 }]
  TotalPrice;

  @UI.hidden: true
  CurrencyCode;

  @UI.lineItem: [{
  position: 80,
  importance: #HIGH
   }]

  //   MUESTRA EL CAMPO EN LA VENTANA DETALLE
  @UI.identification: [{ position: 80 }]
  Description;

  @UI.lineItem: [{
  position: 90,
  importance: #LOW
   }]
  @UI.selectionField: [{ position: 40 }]
  @UI.identification: [{ position: 90 }]
  @UI.textArrangement: #TEXT_ONLY
  OverallStatus;

  @UI.hidden: true
  OverallStatusText;

  @UI.hidden: true
  LocalLastChangedAt;
}